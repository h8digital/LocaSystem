# ── Supabase ──────────────────────────────────────────────────────────────────
# Copie esses valores de: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui   # NUNCA expor publicamente

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=gere_um_secret_seguro_aqui
NEXTAUTH_URL=https://seu-dominio.com.br

# ── Notas ─────────────────────────────────────────────────────────────────────
# Chaves Asaas e SMTP são gerenciadas em Parâmetros → ERP (salvas no banco)
# NUNCA commite o arquivo .env com valores reais
